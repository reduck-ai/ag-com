REDUCK_API_KEY=
# The model, through the Vercel AI Gateway. A deployment on Vercel needs none: it signs in with OIDC.
AI_GATEWAY_API_KEY=
# Optional: PostHog's project key, for the browser chat.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional: where the agent sends a website a visitor asks for that no script covers, as a POST of
# { host } with the key as the bearer.
REQUEST_COVERAGE_URL=
REQUEST_COVERAGE_KEY=
# Optional: a Vercel Blob store, to keep the images visitors add, so their chats show them. A store
# connected to the Vercel project needs none: it signs in with OIDC. Without one, the model still
# sees each image, and the chat shows its name only.
BLOB_READ_WRITE_TOKEN=
