{
	"name": "ag-com",
	"private": true,
	"type": "module",
	"description": "An eve agent that acts on websites with no API, with @reduck-ai/sdk.",
	"license": "MIT",
	"packageManager": "pnpm@11.28.8",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "eve build",
		"dev": "node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js dev",
		"start": "eve start",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@ai-sdk/google": "4.0.125",
		"@reduck-ai/sdk": "2.0.0",
		"eve": "1.1.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/node": "24.19.2",
		"typescript": "7.0.2"
	}
}
