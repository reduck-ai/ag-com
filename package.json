		"@fortawesome/react-fontawesome": "3.5.0",
		"@json-render/core": "0.23.2",
		"@json-render/react": "0.23.2",
		"@reduck-ai/sdk": "2.0.0",
		"@shadcn/react": "0.3.1",
		"@shikijs/core": "3.23.0",
		"@shikijs/engine-javascript": "3.23.0",
		"@shikijs/engine-oniguruma": "3.23.0",
		"@streamdown/cjk": "1.0.3",
		"@streamdown/code": "1.1.1",
