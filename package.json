{
	"name": "shopduck",
	"private": true,
	"type": "module",
	"description": "An eve agent that acts on websites with no API, with @reduck-ai/sdk.",
	"license": "MIT",
	"packageManager": "pnpm@11.28.8",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"build": "eve build",
		"dev": "node --env-file-if-exists=.env.local node_modules/eve/bin/eve.js dev",
		"start": "eve start",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"dev:web": "next dev apps/web",
		"build:web": "next build apps/web"
	},
